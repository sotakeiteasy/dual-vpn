# Рабочий туннель. Обычный файл WireGuard от админа: скопируй его сюда
# под именем corp.conf, wg.conf, wg-<что-нибудь>.conf или wg0-<...>.conf.
#
# Такой файл должен быть ровно один: если подойдут сразу несколько,
# сборка конфига откажется работать.

[Interface]
PrivateKey = <приватный ключ, выданный админом>
Address = 10.0.0.2/32
DNS = 10.10.0.53

[Peer]
PublicKey = <публичный ключ сервера>
Endpoint = vpn.example.com:51820

# Именно отсюда берутся маршруты рабочего туннеля: что перечислено здесь,
# пойдёт в него, всё остальное — в личный. Ставить 0.0.0.0/0 нельзя,
# иначе рабочий туннель заберёт весь трафик.
AllowedIPs = 10.10.0.0/24, 198.51.100.7/32
PersistentKeepalive = 25
