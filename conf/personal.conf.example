# Личный туннель. Скопируй в personal.conf и подставь свои значения.
# Подходят также имена awg-*.conf, amnezia-*.conf или любой файл,
# выбранный личным в окне программы.

[Interface]
PrivateKey = <твой приватный ключ>
Address = 10.9.0.2/32
DNS = 1.1.1.1, 8.8.8.8

# Необязательно. Если строки нет, берётся 1280 — значение, которое
# работает везде. Ставь своё, только если знаешь, что сервер тянет больше.
# MTU = 1420

# Поля AmneziaWG — только если сервер это умеет. Есть они — маскировка
# включена, нет — обычный WireGuard. Отдельно ничего включать не надо.
# Jc = 9
# Jmin = 40
# Jmax = 70
# S1 = 119
# S2 = 112
# S3 = 78
# S4 = 16
# H1 = 57565304-57665304
# H2 = 1037727161-1037827161
# H3 = 1447105519-1447205519
# H4 = 1882654819-1882754819

[Peer]
PublicKey = <публичный ключ сервера>
PresharedKey = <общий ключ, если выдан>
Endpoint = 203.0.113.10:51820
AllowedIPs = 0.0.0.0/0, ::/0
PersistentKeepalive = 25
