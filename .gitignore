# Приватные ключи. Главная причина, по которой этот файл существует.
conf/*.conf
conf/site.env
!conf/*.example

# Рабочее состояние живёт в %ProgramData%\TunnelVPN, но при запуске из
# исходников с TUNNELVPN_DATA=. оно оседает здесь.
state/
lib/state/

# Бинарники: sing-box.exe ~60 МБ и wintun.dll, качаются отдельно (см. README).
lib/bin/

# Окружение и сборка. installer/tunnelvpn.spec написан руками и в репозитории
# нужен — игнорируем только то, что PyInstaller генерирует сам, в build/.
lib/venv/
build/
dist/
*.egg-info/
__pycache__/
*.pyc

# Готовый установщик.
installer/Output/

# Генерируется из icon.svg при сборке.
lib/tunnelvpn/ui/icons/
*.ico

# Локальные индексы инструментов разработки — у каждого свои, в репозитории
# им не место.
.tokensave/
.ragsave/