# Приватные ключи. Главная причина, по которой этот файл существует.
conf/*.conf
conf/site.env
!conf/*.example

# Рабочее состояние живёт в %ProgramData%\DualVPN, но при запуске из
# исходников с DUALVPN_DATA=. оно оседает здесь.
state/
lib/state/

# Бинарники: sing-box.exe ~60 МБ и wintun.dll, качаются отдельно (см. README).
lib/bin/

# Окружение и сборка. installer/dualvpn.spec написан руками и в репозитории
# нужен — игнорируем только то, что PyInstaller генерирует сам, в build/.
lib/venv/
build/
dist/
*.egg-info/
__pycache__/
*.pyc

# Готовый установщик.
installer/Output/

# Генерируется из icon.svg при сборке.
lib/dualvpn/ui/icons/
*.ico
